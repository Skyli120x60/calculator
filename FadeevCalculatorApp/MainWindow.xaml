<Window x:Class="FadeevCalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:FadeevCalculatorApp.Infrastructure"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="580"
        Width="380"
        MinHeight="520"
        MinWidth="340"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        PreviewTextInput="OnPreviewTextInput"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <infra:StringToBrushConverter x:Key="B"/>

        <Style x:Key="CalcBtn" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding KeyForeground, Converter={StaticResource B}}"/>
            <Setter Property="Background" Value="{Binding KeyBackground, Converter={StaticResource B}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalcBtnAccent" TargetType="Button" BasedOn="{StaticResource CalcBtn}">
            <Setter Property="Foreground" Value="{Binding AccentKeyForeground, Converter={StaticResource B}}"/>
            <Setter Property="Background" Value="{Binding AccentKeyBackground, Converter={StaticResource B}}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CalcBtnMuted" TargetType="Button" BasedOn="{StaticResource CalcBtn}">
            <Setter Property="Foreground" Value="{Binding SecondaryText, Converter={StaticResource B}}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Border Background="{Binding PageBackground, Converter={StaticResource B}}" Padding="20,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding WindowTitle}"
                       Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="4,0,4,14"/>

            <Border Grid.Row="1"
                    CornerRadius="18"
                    Background="{Binding PanelBackground, Converter={StaticResource B}}"
                    BorderBrush="{Binding DisplayBorder, Converter={StaticResource B}}"
                    BorderThickness="1"
                    Padding="18,16"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding ExpressionLabelText}"
                               Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                             FontSize="20"
                             FontWeight="Normal"
                             HorizontalContentAlignment="Right"
                             Margin="0,0,0,8"/>
                    <TextBox Grid.Row="2"
                             Text="{Binding ResultText}"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{Binding KeyForeground, Converter={StaticResource B}}"
                             FontSize="34"
                             FontWeight="Light"
                             HorizontalContentAlignment="Right"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CalcBtnMuted}"
                        Command="{Binding AppendCommand}" CommandParameter="(" Content="("/>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CalcBtnMuted}"
                        Command="{Binding AppendCommand}" CommandParameter=")" Content=")"/>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CalcBtnMuted}"
                        Command="{Binding ClearEntryCommand}" Content="CE"/>
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource CalcBtnMuted}"
                        Command="{Binding ClearAllCommand}" Content="C"/>

                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CalcBtnMuted}"
                        Command="{Binding AppendCommand}" CommandParameter="^" Content="xʸ"/>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CalcBtnMuted}"
                        Command="{Binding BackspaceCommand}" Content="⌫" FontSize="15"/>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CalcBtnAccent}"
                        Command="{Binding AppendCommand}" CommandParameter="/" Content="÷"/>
                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource CalcBtnAccent}"
                        Command="{Binding AppendCommand}" CommandParameter="*" Content="×"/>

                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="7" Content="7"/>
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="8" Content="8"/>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="9" Content="9"/>
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource CalcBtnAccent}"
                        Command="{Binding AppendCommand}" CommandParameter="-" Content="−"/>

                <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="4" Content="4"/>
                <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="5" Content="5"/>
                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="6" Content="6"/>
                <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource CalcBtnAccent}"
                        Command="{Binding AppendCommand}" CommandParameter="+" Content="+"/>

                <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="1" Content="1"/>
                <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="2" Content="2"/>
                <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="3" Content="3"/>
                <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="." Content="."/>

                <Button Grid.Row="5" Grid.Column="0" Style="{StaticResource CalcBtn}"
                        Command="{Binding AppendCommand}" CommandParameter="0" Content="0"
                        Grid.ColumnSpan="2"/>
                <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource CalcBtnAccent}"
                        Command="{Binding EvaluateCommand}" Content="="
                        Grid.ColumnSpan="2" FontSize="22"/>
            </Grid>
        </Grid>
    </Border>
</Window>
